# Midtrans Sandbox credential. Keep .env private; never commit Server Key.
MIDTRANS_SERVER_KEY=

# Public HTTPS URL used for Midtrans redirects.
SITE_BASE_URL=https://your-public-domain.example

# Configure this exact URL as the Payment Notification URL in Midtrans Dashboard.
MIDTRANS_NOTIFICATION_URL=https://your-public-domain.example/payments/midtrans/notification/

# Supabase: copy the PostgreSQL Transaction pooler URI from Dashboard > Connect.
# Keep this secret. DATABASE_URL selects PostgreSQL; otherwise Docker uses MySQL.
DATABASE_URL=

# Local Docker MySQL fallback (used only when DATABASE_URL is empty).
DB_NAME=agang_property
DB_USER=root
DB_PASSWORD=root
DB_HOST=db
DB_PORT=3306
